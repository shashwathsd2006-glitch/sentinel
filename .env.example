# SENTINEL-X environment example
# Copy to `.env` (never commit real secrets) and adjust as needed.

# --- Backend ---------------------------------------------------------------
# SQLite database file (created automatically on first start).
# Leave unset to use backend/sentinel.db
SENTINEL_DB_PATH=

# HTTP interface
# Keep 127.0.0.1: the API has NO authentication and must stay localhost-only.
# Do not change this to 0.0.0.0 or a public address for the demo.
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8010

# CORS allow-list (comma-separated origins) for the dashboard.
# Leave unset to use the built-in localhost defaults:
#   http://127.0.0.1:3010, http://localhost:3010,
#   http://127.0.0.1:3000, http://localhost:3000
# CORS is not authentication — it only gates browser cross-origin reads.
SENTINEL_ALLOWED_ORIGINS=

# Risk thresholds used by the deterministic risk engine
SENTINEL_APPROVAL_THRESHOLD=65
SENTINEL_BLOCK_THRESHOLD=80

# Single-use approvals expire after this many minutes
SENTINEL_APPROVAL_TTL_MINUTES=15

# Secret used to sign gateway execution tickets (HMAC-SHA256).
# Leave empty to generate a random per-process secret.
SENTINEL_TICKET_SECRET=

# --- Frontend --------------------------------------------------------------
# Backend API base URL used by the dashboard (build/dev time variable)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8010

# Frontend dev server port (used by scripts/start-frontend.sh)
SENTINEL_WEB_PORT=3010
